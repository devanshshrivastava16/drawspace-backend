# =====================================================================
# DrawSpace Backend — environment variables (CONTRACT §12)
# Copy to .env and adjust. docker-compose.yml in this repo starts a
# matching PostgreSQL instance.
# =====================================================================

# Port the backend HTTP/WS server listens on.
# Frontend linkage: the frontend .env must point VITE_API_BASE_URL and
# VITE_WS_URL at this port.
SERVER_PORT=8080

# PostgreSQL connection (matches docker-compose.yml: db drawspace/drawspace).
DB_URL=jdbc:postgresql://localhost:5432/drawspace
DB_USERNAME=drawspace
DB_PASSWORD=password

# Comma-separated list of allowed CORS origins.
# MUST include the frontend origin (Vite dev server default: http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Room time-to-live in hours: rooms.expires_at = created_at + ROOM_TTL_HOURS.
# Expired rooms are deactivated by the scheduler; joins/ops then fail with 410.
ROOM_TTL_HOURS=24

# A canvas snapshot is persisted every SNAPSHOT_INTERVAL accepted drawing events,
# then announced on /topic/room/{code}/canvas (SNAPSHOT_CREATED) and
# /topic/room/{code}/events (SNAPSHOT_SAVED).
SNAPSHOT_INTERVAL=500

# Participants whose last presence heartbeat (/app/room/{code}/presence, ~25s)
# is older than this many minutes are reaped as stale by the 60s scheduler
# (left_at set + per-room /participants broadcast).
STALE_THRESHOLD_MINUTES=10

# Max participants per room (CONTRACT §10: 2-5). Used for the capacity check on join.
MAX_PARTICIPANTS=5

# ---------------------------------------------------------------------
# Frontend .env (for reference — belongs to the frontend project):
#   VITE_API_BASE_URL=http://localhost:8080/api      (points at SERVER_PORT)
#   VITE_WS_URL=http://localhost:8080/ws-drawspace   (points at SERVER_PORT)
# CORS_ALLOWED_ORIGINS above must contain the frontend origin.
# JSON dates cross the wire as ISO-8601 strings (Instant).
# ---------------------------------------------------------------------
